# mp-archive settings.
# Install this file as /etc/mp-archive/.env and write your values:
#   sudo cp .env.example /etc/mp-archive/.env
#   sudo chown <backup user> /etc/mp-archive/.env
#   sudo chmod 600 /etc/mp-archive/.env
# Do not put .env in git. It contains the secret of your Box app.
#
# The scripts read this file from /etc/mp-archive/.env.
# To use a different folder, set MPARCHIVE_CONFIG_DIR in the environment, for example:
#   MPARCHIVE_CONFIG_DIR=/home/backup/mp-archive ./bin/upload.sh ...
# You cannot set MPARCHIVE_CONFIG_DIR in this file, because this file is in that folder.

# The storage provider. At this time, only "box" is supported.
# The scripts read the accounts from {PROVIDER}.json in the same folder as this file,
# for example /etc/mp-archive/box.json.
PROVIDER=box

# The folder for activity.log and error.log. Use an absolute path.
# The user who runs mp-archive must have write access to this folder.
MPARCHIVE_LOG_DIR=/var/log/mp-archive

# The folder for the tokens of each account. Use an absolute path.
# The scripts change the tokens often, so this folder is not in /etc.
# The scripts make the subfolder "box" with mode 700.
MPARCHIVE_STATE_DIR=/var/lib/mp-archive

# The Client ID and the Client Secret of the Box app.
# Find them in the Box Developer Console > your app > Configuration > OAuth 2.0 Credentials.
# All Box accounts use these two values.
BOX_APP_CLIENT_ID=
BOX_APP_SECRET=

# The Box folder for the backup parts. 0 is the top folder of each account.
BOX_FOLDER_ID=0

# The redirect URI for bin/add-account.sh.
# Add this exact value in the Box Developer Console > your app > Configuration > OAuth 2.0 Redirect URIs.
BOX_REDIRECT_URI=http://localhost
